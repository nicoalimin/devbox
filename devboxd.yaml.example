server:
  listen: "0.0.0.0:8080"
  # auth_token: "your-secret-token-here"  # or set DEVBOXD_AUTH_TOKEN env var

# Opt-in authenticated self-upgrade from this checkout's trusted remote.
upgrade:
  enabled: false
  source_path: "/path/to/devbox"
  remote: "origin"
  branch: "main"
  build_timeout: "20m"
  drain_timeout: "1h"

database:
  # path: ""  # Path to SQLite database file
              # Default: .devbox/jobs.db (relative to current working directory)
              # Can also set DEVBOXD_DB_PATH env var or use --db CLI flag
              # 
              # Breaking change from v0.1.0: old default was ~/.local/share/devbox/jobs.db
              # To use old location, explicitly set: path: "~/.local/share/devbox/jobs.db"

linear:
  # api_key: "lin_api_your_key_here"     # or set LINEAR_API_KEY env var
  assignee_id: ""                         # Optional: only process issues assigned to this user
  workspace_id: ""                        # Optional: workspace ID

opencode:
  version: v2
  base_url: "http://127.0.0.1:3000"       # or set OPENCODE_BASE_URL env var
  timeout: "30m"                          # Coding session timeout
  review_timeout: "15m"                   # Interrupt a stuck review, then validate/deliver safely
  
  # HTTP Basic Authentication for OpenCode 2.0.3+ (when OPENCODE_SERVER_PASSWORD is set)
  # username: "opencode"                  # or set DEVBOXD_OPENCODE_USERNAME / OPENCODE_SERVER_USERNAME env var
  # password: "your-password-here"        # or set DEVBOXD_OPENCODE_PASSWORD / OPENCODE_SERVER_PASSWORD env var
  #
  # When OpenCode server is started with OPENCODE_SERVER_PASSWORD set, all API requests
  # require HTTP Basic Auth. The username defaults to "opencode" unless OPENCODE_SERVER_USERNAME
  # is set. Configure matching credentials here or via environment variables.

github:
  default_base_branch: "main"

# Map Linear issue attributes to repository paths
repos:
  - match:
      team: "ENG"
    repo:
      path: "/path/to/your/backend"
      base_branch: "main"
      # Omit to detect write-mode Node format scripts (including nested apps).
      # Set [] to disable, or provide commands relative to the worktree root.
      # format_commands:
      #   - "cd web && pnpm exec prettier --write ."
      # Omit to auto-detect common Go and Node CI checks. Set [] to disable.
      validation_commands:
        - "go test ./..."
        - "go vet ./..."
  
  - match:
      project: "Frontend Redesign"
    repo:
      path: "/path/to/your/frontend"
      base_branch: "develop"
  
  - match:
      label: "infrastructure"
    repo:
      path: "/path/to/your/infra"
      base_branch: "main"

queue:
  enabled: false  # Default: reject when busy
  max_depth: 1    # Only if enabled

# Periodic GitHub reconciler for stuck pr_open jobs (UTA-68).
# Polls GitHub for jobs waiting on external PR state and advances them to a
# terminal state (merged -> done, closed unmerged -> cancelled).
reconciler:
  enabled: true   # Default: true (set false to disable polling)
  interval: "2m"  # Default: 2m (~1-5m recommended; rate-limit friendly)
