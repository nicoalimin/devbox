# Linear API Configuration
# Get your Linear API key from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_YOUR_KEY_HERE

# Linear Assignee ID (the user ID of the OpenCode/devbox agent in Linear)
# CRITICAL: Only issues assigned to this EXACT user will be processed by OpenCode.
# Issues assigned to other users, unassigned issues, or team-wide issues are NEVER picked up.
#
# To find this ID:
# 1. Create or identify the Linear user that represents your OpenCode/devbox agent
# 2. Go to https://linear.app/settings/api
# 3. Run this query in the GraphQL explorer (logged in as that user):
#    query { viewer { id name email } }
# 4. Copy the returned ID below
#
# Example: If the devbox user email is devbox@company.com, this should be that user's ID
LINEAR_ASSIGNEE_ID=YOUR_DEVBOX_USER_ID_HERE

# Linear issue states to poll (JSON array of state names)
# Only issues in these states AND assigned to LINEAR_ASSIGNEE_ID will be processed
# Common states: "Todo", "Triage", "Backlog", "In Progress"
# Customize based on your Linear workflow
LINEAR_STATES=["Todo", "Triage", "Backlog"]

# Optional: Automatically transition issues to "In Progress" when assigned to OpenCode
# Set to "true" to enable, "false" or omit to disable
# If disabled, the OpenCode agent instructions will handle status updates
LINEAR_AUTO_TRANSITION=false

# Optional: Linear state ID for "In Progress" (required if LINEAR_AUTO_TRANSITION=true)
# To find this:
# 1. Go to https://linear.app/settings/api
# 2. Run this query: query { workflowStates { nodes { id name type } } }
# 3. Find the ID for your "In Progress" state
# LINEAR_IN_PROGRESS_STATE_ID=YOUR_STATE_ID_HERE

# OpenCode Configuration
# Base URL for the local OpenCode instance
# Default: http://127.0.0.1:3000 (adjust port if different)
OPENCODE_BASE_URL=http://127.0.0.1:3000

# Optional: OpenCode authentication (if configured)
# OPENCODE_SERVER_USERNAME=your_username
# OPENCODE_SERVER_PASSWORD=your_password

# n8n Configuration
# Poll interval is configured in the workflow (default: 5 minutes)
# You can adjust this in the n8n UI after importing